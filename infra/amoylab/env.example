NOMI_IMAGE=ghcr.io/ifuryst/nomi-server:latest
NOMI_SERVER_PORT=8088
NOMI_IMAGE_STORAGE_DIR=/var/lib/nomi/uploads
NOMI_PUBLIC_BASE_URL=https://nomi.ifuryst.com
NOMI_DATABASE_URL=postgres://nomi:replace-with-remote-password@postgres:5432/nomi?sslmode=disable&connect_timeout=5
NOMI_SEEDX_API_KEY=replace-with-remote-seedx-key
