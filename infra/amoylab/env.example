NOMI_IMAGE=ghcr.io/ifuryst/nomi-server:latest
NOMI_SERVER_PORT=8088
NOMI_DATABASE_URL=postgres://nomi:replace-with-remote-password@postgres:5432/nomi?sslmode=disable&connect_timeout=5
NOMI_SEEDX_API_KEY=replace-with-remote-seedx-key
NOMI_BOOTSTRAP_INVITE_CODE=replace-with-one-time-family-bootstrap-code
NOMI_ASSET_SIGNING_KEY=replace-with-at-least-32-random-bytes
NOMI_SESSION_DURATION=720h
NOMI_SEEDX_CODEX_MODEL=
NOMI_SEEDX_CODEX_REASONING_EFFORT=low
NOMI_SEEDX_COMMAND_TIMEOUT=5m
