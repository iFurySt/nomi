{
  "schema": "nomi-interactive-ir/draft-1",
  "id": "program_temperature",
  "version": 1,
  "profile": "portable.learning/draft-1",
  "requires": {
    "components": {
      "Panel": 1,
      "Row": 1,
      "Text": 1,
      "Button": 1,
      "SegmentedControl": 1,
      "Slider": 1,
      "Math": 1,
      "Plot": 1
    },
    "functions": {
      "math.softmax": 1,
      "array.replaceAt": 1,
      "array.at": 1
    },
    "expressions": [
      "literal",
      "state",
      "variable",
      "derived",
      "call",
      "match",
      "map",
      "object",
      "sampleFamily"
    ],
    "hostEffects": []
  },
  "budget": {
    "maxSamplePointsPerSeries": 201,
    "maxSeries": 8,
    "maxStepsPerEvaluation": 50000
  },
  "state": {
    "temperature": {
      "type": "number",
      "default": 0.85,
      "min": 0.2,
      "max": 3.0,
      "step": 0.01,
      "scope": "user"
    },
    "mode": {
      "type": "enum",
      "values": ["logit", "temperature"],
      "default": "logit",
      "scope": "user"
    },
    "logits": {
      "type": "vector",
      "itemType": "number",
      "length": 3,
      "default": [2, 1, 0.1],
      "scope": "user"
    }
  },
  "derived": {
    "probabilities": {
      "kind": "call",
      "function": "math.softmax",
      "version": 1,
      "args": [
        {
          "kind": "state",
          "id": "logits"
        },
        {
          "kind": "state",
          "id": "temperature"
        }
      ]
    },
    "logitCurves": {
      "kind": "sampleFamily",
      "seriesVariable": "i",
      "seriesValues": [0, 1, 2],
      "sampleVariable": "x",
      "domain": [-4, 4],
      "count": 161,
      "value": {
        "kind": "call",
        "function": "array.at",
        "version": 1,
        "args": [
          {
            "kind": "call",
            "function": "math.softmax",
            "version": 1,
            "args": [
              {
                "kind": "call",
                "function": "array.replaceAt",
                "version": 1,
                "args": [
                  {
                    "kind": "state",
                    "id": "logits"
                  },
                  {
                    "kind": "variable",
                    "id": "i"
                  },
                  {
                    "kind": "variable",
                    "id": "x"
                  }
                ]
              },
              {
                "kind": "state",
                "id": "temperature"
              }
            ]
          },
          {
            "kind": "variable",
            "id": "i"
          }
        ]
      }
    },
    "temperatureCurves": {
      "kind": "sampleFamily",
      "seriesVariable": "i",
      "seriesValues": [0, 1, 2],
      "sampleVariable": "x",
      "domain": [0.2, 3],
      "count": 141,
      "value": {
        "kind": "call",
        "function": "array.at",
        "version": 1,
        "args": [
          {
            "kind": "call",
            "function": "math.softmax",
            "version": 1,
            "args": [
              {
                "kind": "state",
                "id": "logits"
              },
              {
                "kind": "variable",
                "id": "x"
              }
            ]
          },
          {
            "kind": "variable",
            "id": "i"
          }
        ]
      }
    },
    "activeCurves": {
      "kind": "match",
      "value": {
        "kind": "state",
        "id": "mode"
      },
      "cases": {
        "logit": {
          "kind": "derived",
          "id": "logitCurves"
        },
        "temperature": {
          "kind": "derived",
          "id": "temperatureCurves"
        }
      }
    },
    "xAxis": {
      "kind": "match",
      "value": {
        "kind": "state",
        "id": "mode"
      },
      "cases": {
        "logit": {
          "kind": "literal",
          "value": {
            "label": "Logit",
            "domain": [-4, 4],
            "scale": "linear"
          }
        },
        "temperature": {
          "kind": "literal",
          "value": {
            "label": "Temperature",
            "domain": [0.2, 3],
            "scale": "linear"
          }
        }
      }
    },
    "markers": {
      "kind": "map",
      "variable": "i",
      "items": {
        "kind": "literal",
        "value": [0, 1, 2]
      },
      "body": {
        "kind": "object",
        "fields": {
          "series": {
            "kind": "variable",
            "id": "i"
          },
          "x": {
            "kind": "match",
            "value": {
              "kind": "state",
              "id": "mode"
            },
            "cases": {
              "logit": {
                "kind": "call",
                "function": "array.at",
                "version": 1,
                "args": [
                  {
                    "kind": "state",
                    "id": "logits"
                  },
                  {
                    "kind": "variable",
                    "id": "i"
                  }
                ]
              },
              "temperature": {
                "kind": "state",
                "id": "temperature"
              }
            }
          },
          "y": {
            "kind": "call",
            "function": "array.at",
            "version": 1,
            "args": [
              {
                "kind": "derived",
                "id": "probabilities"
              },
              {
                "kind": "variable",
                "id": "i"
              }
            ]
          }
        }
      }
    }
  },
  "actions": {
    "reset": {
      "kind": "reset",
      "scope": "user",
      "targets": ["temperature", "mode", "logits"]
    }
  },
  "root": "view.root",
  "nodes": [
    {
      "id": "view.root",
      "component": "Panel",
      "version": 1,
      "props": {
        "children": [
          "view.toolbar",
          "control.mode",
          "control.temperature",
          "view.explanation",
          "view.formula",
          "view.plot"
        ]
      }
    },
    {
      "id": "view.toolbar",
      "component": "Row",
      "version": 1,
      "props": {
        "children": ["view.title", "control.reset"]
      }
    },
    {
      "id": "view.title",
      "component": "Text",
      "version": 1,
      "props": {
        "text": "Temperature Explorer",
        "role": "heading"
      }
    },
    {
      "id": "control.reset",
      "component": "Button",
      "version": 1,
      "props": {
        "label": "Reset"
      },
      "on": {
        "activate": "reset"
      }
    },
    {
      "id": "control.mode",
      "component": "SegmentedControl",
      "version": 1,
      "props": {
        "label": "探索模式",
        "options": [
          {
            "value": "logit",
            "label": "Logit → Probability"
          },
          {
            "value": "temperature",
            "label": "Temperature → Probability"
          }
        ]
      },
      "bind": {
        "value": "mode"
      }
    },
    {
      "id": "control.temperature",
      "component": "Slider",
      "version": 1,
      "props": {
        "label": "Temperature (τ)",
        "min": 0.2,
        "max": 3,
        "step": 0.01,
        "marks": [
          {
            "value": 0.2,
            "label": "Sharp"
          },
          {
            "value": 1,
            "label": "Normal"
          },
          {
            "value": 3,
            "label": "Flat"
          }
        ]
      },
      "bind": {
        "value": "temperature"
      }
    },
    {
      "id": "view.explanation",
      "component": "Text",
      "version": 1,
      "props": {
        "text": {
          "kind": "match",
          "value": {
            "kind": "state",
            "id": "mode"
          },
          "cases": {
            "logit": {
              "kind": "literal",
              "value": "每条曲线只改变对应 token 的 logit，其余 logits 固定。"
            },
            "temperature": {
              "kind": "literal",
              "value": "固定全部 logits，观察温度如何改变输出分布。"
            }
          }
        }
      }
    },
    {
      "id": "view.formula",
      "component": "Math",
      "version": 1,
      "props": {
        "source": "p_i=\\frac{e^{z_i/\\tau}}{\\sum_j e^{z_j/\\tau}}"
      }
    },
    {
      "id": "view.plot",
      "component": "Plot",
      "version": 1,
      "props": {
        "series": {
          "kind": "derived",
          "id": "activeCurves"
        },
        "markers": {
          "kind": "derived",
          "id": "markers"
        },
        "xAxis": {
          "kind": "derived",
          "id": "xAxis"
        },
        "yAxis": {
          "label": "P",
          "domain": [0, 1],
          "format": "percent"
        },
        "seriesLabels": ["Token A", "Token B", "Token C"]
      }
    }
  ]
}
