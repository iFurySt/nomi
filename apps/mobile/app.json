{
  "expo": {
    "name": "Nomi",
    "slug": "nomi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Nomi uses the camera to capture the original image for upload.",
        "NSPhotoLibraryUsageDescription": "Nomi uses the photo library to select the original image for upload.",
        "NSPhotoLibraryAddUsageDescription": "Nomi may save generated upload assets when you choose to keep them."
      },
      "bundleIdentifier": "com.anonymous.nomi"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
