{
  "name": "nomi",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "dev:desktop": "pnpm --filter @nomi/desktop dev",
    "build": "pnpm --filter @nomi/web build && pnpm --filter @nomi/desktop build",
    "check": "tsc --noEmit",
    "preview": "pnpm --filter @nomi/web preview",
    "desktop": "pnpm --filter @nomi/desktop start",
    "test": "vitest run packages/core/src packages/platform/src packages/host/src packages/ui/src",
    "smoke:desktop": "pnpm --filter @nomi/desktop smoke && pnpm smoke:canvas && pnpm smoke:notes",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json,css}\" \"scripts/*.mjs\" package.json tsconfig.json",
    "profile:notes": "node scripts/profile-notes.mjs",
    "check:repo": "make ci",
    "check:interactive-native": "node scripts/check-interactive-native.mjs",
    "smoke:canvas": "node scripts/check-canvas.mjs",
    "smoke:document-directory": "node scripts/check-document-directory.mjs",
    "smoke:notes": "node scripts/check-notes.mjs",
    "smoke:notes-ime": "node scripts/check-notes-ime.mjs",
    "package:desktop": "pnpm build && node scripts/package-desktop.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "jose": "6.2.12",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
