{
  "name": "nomi",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "dev:desktop": "pnpm --filter @nomi/desktop dev",
    "build": "pnpm --filter @nomi/web build && pnpm --filter @nomi/desktop build",
    "check": "tsc --noEmit",
    "preview": "pnpm --filter @nomi/web preview",
    "desktop": "pnpm --filter @nomi/desktop start",
    "test": "vitest run packages/core/src packages/platform/src packages/host/src packages/ui/src",
    "smoke:desktop": "pnpm --filter @nomi/desktop smoke && pnpm smoke:interactions && pnpm smoke:learning && pnpm smoke:canvas && pnpm smoke:notes",
    "smoke:interactions": "node scripts/check-ui-continuity.mjs",
    "smoke:codex": "node scripts/check-codex-runtime.mjs",
    "smoke:chart-tools": "node scripts/check-stock-chart-tools.mjs",
    "smoke:stocks-layout": "node scripts/check-stocks-responsive.mjs",
    "smoke:stocks-cache": "node scripts/check-stock-list-reentry.mjs",
    "smoke:stock-activity": "node scripts/check-stock-activity.mjs",
    "smoke:funds": "node scripts/check-funds.mjs",
    "smoke:financials": "node scripts/check-financials.mjs",
    "smoke:navigation": "node scripts/check-workspace-navigation.mjs",
    "smoke:storage": "node scripts/check-storage-ui.mjs",
    "smoke:account": "node scripts/check-account-ui.mjs",
    "smoke:chatgpt": "node scripts/check-chatgpt.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json,css}\" \"scripts/*.mjs\" package.json tsconfig.json",
    "smoke:loading": "node scripts/check-loading-skeletons.mjs",
    "smoke:selects": "node scripts/check-selects.mjs",
    "smoke:selection": "node scripts/check-text-selection.mjs",
    "smoke:mcp": "node scripts/check-mcp-runtime.mjs",
    "profile:mcp": "node scripts/profile-mcp.mjs",
    "smoke:arena": "node scripts/check-arena.mjs",
    "check:desktop-go": "bash scripts/check-desktop-go.sh",
    "check:repo": "make ci",
    "smoke:dev-security": "node scripts/check-dev-file-boundary.mjs",
    "smoke:learning": "node scripts/check-interactive-learning.mjs",
    "check:interactive-native": "node scripts/check-interactive-native.mjs",
    "smoke:canvas": "node scripts/check-canvas.mjs",
    "smoke:notes": "node scripts/check-notes.mjs"
  },
  "devDependencies": {
    "@openai/codex": "0.160.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "jose": "6.2.12",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
